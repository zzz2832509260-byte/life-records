      "short_name": "灵感",
      "url": "./?tab=notes",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "记一条任务",
      "short_name": "任务",
      "url": "./?tab=tasks",
